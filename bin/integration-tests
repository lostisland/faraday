#!/bin/bash
# Run Faraday integration tests using act (GitHub Actions locally)
#
# This script runs the integration tests workflow exactly as it runs in CI,
# using service containers for httpbin and other dependencies.

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Faraday Integration Tests Runner"
echo "================================="
echo

# Check if act is installed
if ! command -v act &> /dev/null; then
  echo -e "${YELLOW}act is not installed${NC}"
  echo
  echo "act is required to run integration tests locally."
  echo "See: https://github.com/nektos/act"
  echo

  # Check if Homebrew is available (macOS/Linux)
  if command -v brew &> /dev/null; then
    echo -e "${YELLOW}Would you like to install act via Homebrew? (y/n)${NC}"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      echo "Installing act..."
      brew install act
      echo -e "${GREEN}✓ act installed successfully${NC}"
      echo
    else
      echo "Please install act manually:"
      echo "  macOS: brew install act"
      echo "  Linux: See https://github.com/nektos/act#installation"
      exit 1
    fi
  else
    echo -e "${RED}Homebrew not found.${NC}"
    echo "Please install act manually: https://github.com/nektos/act#installation"
    exit 1
  fi
fi

echo "Running integration tests with act..."
echo

# Run act with recommended settings for Apple Silicon
# - Use catthehacker/ubuntu:act-latest for better compatibility
# - Force linux/amd64 architecture (M-series chip compatibility)
act -j integration \
  -W .github/workflows/integration-tests.yml \
  -P ubuntu-latest=catthehacker/ubuntu:act-latest \
  --container-architecture linux/amd64 \
  "$@"

exit_code=$?

if [ $exit_code -eq 0 ]; then
  echo
  echo -e "${GREEN}✓ Integration tests passed!${NC}"
else
  echo
  echo -e "${RED}✗ Integration tests failed${NC}"
  echo
  echo "To run specific tests:"
  echo "  HTTPBIN_URL=http://localhost bundle exec rspec spec/integration/options/request_options_integration_spec.rb"
  echo
  echo "To start httpbin manually:"
  echo "  docker run --rm -p 80:80 kennethreitz/httpbin"
fi

exit $exit_code
